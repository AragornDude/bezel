# vim: filetype=toml

# Bezel Configuration Template
# Place this file in: ~/.config/bezel/config.toml

# Customize how thick the edge zones are (0.08 means 8% of the trackpad)
[zones]
left_width = 0.08
right_width = 0.08
top_height = 0.08
bottom_height = 0.08

# ---- Left Zone Gestures ----
[gestures.left.up]
action = "command"
cmd = "wpctl set-volume @DEFAULT_SINK@ 5%+"

[gestures.left.down]
action = "command"
cmd = "wpctl set-volume @DEFAULT_SINK@ 5%-"

[gestures.left.tap]
action = "command"
cmd = "wpctl set-mute @DEFAULT_SINK@ toggle"

# ---- Right Zone Gestures ----
[gestures.right.up]
action = "command"
cmd = "brightnessctl set 10%+"

[gestures.right.down]
action = "command"
cmd = "brightnessctl set 10%-"

# ---- Top Zone Gestures ----
# Hyprland 0.55+ commands; change these for other compositors or older Hyprland.
[gestures.top.left]
action = "command"
cmd = "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"

[gestures.top.right]
action = "command"
cmd = "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"

[gestures.top.tap]
action = "command"
cmd = "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"magic\")'"

# ---- Bottom Zone Gestures ----
[gestures.bottom.left]
action = "command"
cmd = "playerctl previous"

[gestures.bottom.right]
action = "command"
cmd = "playerctl next"

[gestures.bottom.tap]
action = "command"
cmd = "playerctl play-pause"

# ---- OSD Configuration ----
[osd]
enabled = false
backend = "notify-send" # options: "notify-send", "swayosd", "pipe"
canonical_hints = false # set to true if using mako or notify-osd
# pipe_path = "/tmp/bezel-osd" # only if backend is "pipe"

# Shared recognition defaults. Distances are fractions of each trackpad axis.
[recognition]
join_ms = 80
swipe_distance = 0.05
tap_distance = 0.02
tap_ms = 200
double_tap_ms = 300
hold_ms = 500
step_distance = 0.03

# Optional multi-finger bindings. Uncomment to enable.
# The first finger starts at the edge; other fingers join within join_ms.
# [[bindings]]
# zone = "left"
# fingers = 2
# gesture = "slide_up"
# action = "command"
# cmd = "wpctl set-volume @DEFAULT_SINK@ 2%+"
# step_distance = 0.03

# [[bindings]]
# zone = "left"
# fingers = 2
# gesture = "slide_down"
# action = "command"
# cmd = "wpctl set-volume @DEFAULT_SINK@ 2%-"

# [[bindings]]
